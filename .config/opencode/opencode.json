{
  "$schema": "https://opencode.ai/config.json",
  "keybinds": {
    "input_newline": "shift+return,shift+enter,alt+enter,alt+return",
    "messages_half_page_up": "shift+up",
    "messages_half_page_down": "shift+down"
  },
  "plugin": [
    // "@mohak34/opencode-notifier@0.1.15"
  ],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "gpt-oss:20b": {
          "name": "gpt-oss:20b"
        },
        "qwen3-coder:30b": {
          "name": "qwen3-coder:30b"
        },
        "gemma4:26b": {
          "name": "gemma4:26b"
        },
        "gemma4:12b-mlx": {
          "name": "gemma4:12b-mlx"
        },
        "gemma4:e4b-mlx": {
          "name": "gemma4:e4b-mlx"
        },
        "gemma4:e2b-mlx": {
          "name": "gemma4:e2b-mlx"
        },
        "translategemma:12b": {
          "name": "translategemma:12b"
        },
        "muse-glimmer:30b-mlx": {
          "name": "muse-glimmer:30b-mlx"
        }
      }
    }
  },
  "permission": {
    "*": "ask",
    "*.env": "deny",
    "*.env.*": "deny",
    "*.env.example": "allow"
  }
}
